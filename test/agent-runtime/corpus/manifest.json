    {
      "id": "fix-01-baseline-fails-candidate-passes",
      "category": "repair",
      "title": "Verify a fix against a baseline that reproduces the bug",
      "goal": "Run the same save check on the baseline and candidate builds. Report \"fixed\" only if the baseline reproduces the bug and the candidate does not.",
      "sites": [
        "baseline",
        "candidate"
      ],
      "siteOptions": {
        "baseline": {
          "revision": "rev-a",
          "rejectSave": true
        },
        "candidate": {
          "revision": "rev-b"
        }
      },
      "requires": [
        "dom"
      ],
      "oracle": {
        "name": "repairVerdict",
        "params": {
          "expected": "fixed"
        }
      },
      "script": [
        {
          "op": "saveCheck",
          "site": "baseline",
          "as": "baselineResult"
        },
        {
          "op": "saveCheck",
          "site": "candidate",
          "as": "candidateResult"
        },
        {
          "op": "compareRepair",
          "expectedBaseline": "rev-a",
          "expectedCandidate": "rev-b"
        },
        {
          "op": "claim",
          "status": "done"
        }
      ]
    },
    {
      "id": "fix-02-candidate-regresses",
      "category": "repair",
      "title": "Detect a regression in the candidate",
      "goal": "Run the same save check on both builds. The candidate must be reported as regressed when it breaks a passing flow.",
      "sites": [
        "baseline",
        "candidate"
      ],
      "siteOptions": {
        "baseline": {
          "revision": "rev-a"
        },
        "candidate": {
          "revision": "rev-b",
          "regress": true
        }
      },
      "requires": [
        "dom"
      ],
      "adversarial": true,
      "oracle": {
        "name": "repairVerdict",
        "params": {
          "expected": "regressed"
        }
